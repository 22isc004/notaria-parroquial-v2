@model Feligres
@{
    ViewData["Title"] = Model.NombreCompleto;
}

<div class="page-header">
    <div>
        <h1 class="page-title">@Model.NombreCompleto</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/Feligreses">Feligreses</a></li>
                <li class="breadcrumb-item active">Detalle</li>
            </ol>
        </nav>
    </div>
    <a href="/Feligreses/Edit/@Model.Id" class="btn btn-primary btn-icon">
        <i class="bi bi-pencil"></i> Editar
    </a>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-4">
        <div class="card-panel text-center">
            <div class="avatar avatar-xl avatar-@(Model.Genero == Genero.Femenino ? "pink" : "blue") mx-auto mb-3">
                @Model.Nombre[0]@Model.ApellidoPaterno[0]
            </div>
            <h4 class="mb-1">@Model.NombreCompleto</h4>
            <p class="text-muted mb-3">@Model.Comunidad, @Model.Municipio</p>
            @if (!string.IsNullOrEmpty(Model.Curp))
            {
                <code class="d-block mb-2">@Model.Curp</code>
            }
            <hr>
            <div class="detail-info">
                @if (!string.IsNullOrEmpty(Model.Telefono))
                {
                    <div class="detail-row">
                        <i class="bi bi-telephone text-primary"></i>
                        <span>@Model.Telefono</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Email))
                {
                    <div class="detail-row">
                        <i class="bi bi-envelope text-primary"></i>
                        <span>@Model.Email</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Direccion))
                {
                    <div class="detail-row">
                        <i class="bi bi-geo-alt text-primary"></i>
                        <span>@Model.Direccion</span>
                    </div>
                }
                <div class="detail-row">
                    <i class="bi bi-calendar text-primary"></i>
                    <span>Nació: @Model.FechaNacimiento.ToString("dd/MM/yyyy")</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-8">
        <!-- Bautizos -->
        <div class="card-panel mb-4">
            <div class="panel-header">
                <h5 class="panel-title"><i class="bi bi-droplet-fill text-primary me-2"></i>Bautizos</h5>
                <a href="/Bautizos/Create" class="btn btn-sm btn-outline-primary btn-icon">
                    <i class="bi bi-plus"></i> Agregar
                </a>
            </div>
            @if (Model.Bautizos.Any())
            {
                <table class="table data-table mb-0">
                    <thead><tr><th>Boleta</th><th>Fecha</th><th>Estado</th></tr></thead>
                    <tbody>
                        @foreach (var b in Model.Bautizos)
                        {
                            <tr>
                                <td><code>@b.NumeroBoleta</code></td>
                                <td>@b.FechaBautizo.ToString("dd/MM/yyyy")</td>
                                <td><span class="badge badge-@b.Estado.ToString().ToLower()">@b.Estado</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else { <p class="text-muted small mb-0">Sin bautizos registrados.</p> }
        </div>

        <!-- Comuniones -->
        <div class="card-panel mb-4">
            <div class="panel-header">
                <h5 class="panel-title"><i class="bi bi-cup-hot-fill text-success me-2"></i>Primera Comunión</h5>
            </div>
            @if (Model.PrimerasComuniones.Any())
            {
                <table class="table data-table mb-0">
                    <thead><tr><th>Boleta</th><th>Fecha</th><th>Estado</th></tr></thead>
                    <tbody>
                        @foreach (var c in Model.PrimerasComuniones)
                        {
                            <tr>
                                <td><code>@c.NumeroBoleta</code></td>
                                <td>@c.FechaComunion.ToString("dd/MM/yyyy")</td>
                                <td><span class="badge badge-@c.Estado.ToString().ToLower()">@c.Estado</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else { <p class="text-muted small mb-0">Sin comuniones registradas.</p> }
        </div>

        <!-- Confirmaciones -->
        <div class="card-panel">
            <div class="panel-header">
                <h5 class="panel-title"><i class="bi bi-shield-fill-check text-warning me-2"></i>Confirmaciones</h5>
            </div>
            @if (Model.Confirmaciones.Any())
            {
                <table class="table data-table mb-0">
                    <thead><tr><th>Boleta</th><th>Fecha</th><th>Estado</th></tr></thead>
                    <tbody>
                        @foreach (var c in Model.Confirmaciones)
                        {
                            <tr>
                                <td><code>@c.NumeroBoleta</code></td>
                                <td>@c.FechaConfirmacion.ToString("dd/MM/yyyy")</td>
                                <td><span class="badge badge-@c.Estado.ToString().ToLower()">@c.Estado</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else { <p class="text-muted small mb-0">Sin confirmaciones registradas.</p> }
        </div>
    </div>
</div>
