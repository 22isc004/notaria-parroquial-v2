@model CambiarPasswordViewModel
@{
    ViewData["Title"] = "Cambiar Contraseña";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Cambiar Contraseña</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/Usuarios">Usuarios</a></li>
                <li class="breadcrumb-item active">Cambiar Contraseña</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-5">
        <div class="card-panel">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="user-avatar-sm" style="width:44px;height:44px;font-size:1.1rem">
                    <i class="bi bi-person-fill"></i>
                </div>
                <div>
                    <div class="fw-600">@Model.NombreCompleto</div>
                    <div class="text-muted small">Restablecimiento de contraseña</div>
                </div>
            </div>
            <form asp-action="CambiarPassword" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <input asp-for="NombreCompleto" type="hidden" />
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="NuevaPassword" class="form-label"></label>
                        <input asp-for="NuevaPassword" class="form-control" type="password" placeholder="Mínimo 6 caracteres" autofocus />
                        <span asp-validation-for="NuevaPassword" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="ConfirmarPassword" class="form-label"></label>
                        <input asp-for="ConfirmarPassword" class="form-control" type="password" placeholder="Repite la nueva contraseña" />
                        <span asp-validation-for="ConfirmarPassword" class="text-danger small"></span>
                    </div>
                </div>
                <div class="form-actions mt-4">
                    <a href="/Usuarios" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary btn-icon">
                        <i class="bi bi-key-fill"></i> Cambiar Contraseña
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
}
