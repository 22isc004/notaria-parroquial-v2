@model CrearUsuarioViewModel
@{
    ViewData["Title"] = "Nuevo Usuario";
    string[] roles = ["Administrador", "Operador", "Consulta"];
}

<div class="page-header">
    <div>
        <h1 class="page-title">Nuevo Usuario</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/Usuarios">Usuarios</a></li>
                <li class="breadcrumb-item active">Nuevo</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-6">
        <div class="card-panel">
            <form asp-action="Create" method="post">
                <div class="form-section-title"><i class="bi bi-person-fill me-2"></i>Datos del Usuario</div>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="NombreCompleto" class="form-label"></label>
                        <input asp-for="NombreCompleto" class="form-control" placeholder="Nombre completo" autofocus />
                        <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Email" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" type="email" placeholder="correo@ejemplo.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Rol" class="form-label"></label>
                        <select asp-for="Rol" class="form-select">
                            @foreach (var r in roles)
                            {
                                <option value="@r">@r</option>
                            }
                        </select>
                        <div class="form-text">
                            <strong>Administrador</strong>: acceso total. &nbsp;
                            <strong>Operador</strong>: crea y edita registros. &nbsp;
                            <strong>Consulta</strong>: solo lectura.
                        </div>
                        <span asp-validation-for="Rol" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" type="password" placeholder="Mínimo 6 caracteres" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="ConfirmarPassword" class="form-label"></label>
                        <input asp-for="ConfirmarPassword" class="form-control" type="password" placeholder="Repite la contraseña" />
                        <span asp-validation-for="ConfirmarPassword" class="text-danger small"></span>
                    </div>
                </div>
                <div class="form-actions mt-4">
                    <a href="/Usuarios" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary btn-icon">
                        <i class="bi bi-check-lg"></i> Crear Usuario
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
}
