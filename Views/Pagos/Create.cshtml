@model Pago
@{
    ViewData["Title"] = "Registrar Pago";
    var hoy = DateTime.Today.ToString("yyyy-MM-dd");
    string? tipo = ViewBag.Tipo as string;
    int? sacramentoId = ViewBag.SacramentoId as int?;
    bool tieneContexto = !string.IsNullOrEmpty(tipo) && sacramentoId.HasValue;
    var tipoLabel = tipo switch {
        "Bautizo"         => "Bautizo",
        "PrimeraComunion" => "Primera Comunión",
        "Confirmacion"    => "Confirmación",
        "Matrimonio"      => "Matrimonio",
        _                 => ""
    };
}

<div class="page-header">
    <div>
        <h1 class="page-title">Registrar Pago</h1>
        <nav aria-label="breadcrumb"><ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Pagos">Pagos</a></li>
            <li class="breadcrumb-item active">Nuevo</li>
        </ol></nav>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-7">

        @* Aviso de contexto cuando se llega desde un sacramento *@
        @if (tieneContexto)
        {
            <div class="alert alert-info d-flex align-items-center gap-2 mb-4">
                <i class="bi bi-link-45deg fs-5 flex-shrink-0"></i>
                <div>
                    Este pago se vinculará automáticamente al registro de
                    <strong>@tipoLabel</strong> seleccionado.
                </div>
            </div>
        }

        <div class="card-panel">
            <form asp-action="Create" method="post">
                @* Campos ocultos para vincular al sacramento *@
                @if (tieneContexto)
                {
                    <input type="hidden" name="tipo" value="@tipo" />
                    <input type="hidden" name="sacramentoId" value="@sacramentoId" />
                }

                <div class="form-section-title"><i class="bi bi-receipt me-2 text-success"></i>Información del Pago</div>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="TipoServicio" class="form-label"></label>
                        <select asp-for="TipoServicio" class="form-select" asp-items="Html.GetEnumSelectList<TipoServicio>()">
                            <option value="">— Seleccionar —</option>
                        </select>
                        <span asp-validation-for="TipoServicio" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="MetodoPago" class="form-label"></label>
                        <select asp-for="MetodoPago" class="form-select" asp-items="Html.GetEnumSelectList<MetodoPago>()"></select>
                        <span asp-validation-for="MetodoPago" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="NombreSolicitante" class="form-label"></label>
                        <input asp-for="NombreSolicitante" class="form-control" placeholder="Nombre completo del feligrés" />
                        <span asp-validation-for="NombreSolicitante" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="EmailNotificacion" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="EmailNotificacion" class="form-control" type="email" placeholder="correo@ejemplo.com" />
                        </div>
                        <div class="form-text">Al confirmar el pago, se enviará un correo automático a esta dirección.</div>
                        <span asp-validation-for="EmailNotificacion" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Monto" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="Monto" class="form-control" type="number" step="0.01" min="0.01" placeholder="0.00" />
                            <span class="input-group-text">MXN</span>
                        </div>
                        <span asp-validation-for="Monto" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="FechaPago" class="form-label"></label>
                        <input asp-for="FechaPago" class="form-control" type="date" min="@hoy" />
                        <span asp-validation-for="FechaPago" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Notas" class="form-label"></label>
                        <textarea asp-for="Notas" class="form-control" rows="2" placeholder="Observaciones adicionales (opcional)…"></textarea>
                        <span asp-validation-for="Notas" class="text-danger small"></span>
                    </div>
                </div>

                <div class="alert alert-info d-flex align-items-center gap-2 mt-3">
                    <i class="bi bi-info-circle-fill flex-shrink-0"></i>
                    <div class="small">El pago se registrará como <strong>Pendiente</strong>. Desde el detalle podrás confirmarlo o rechazarlo.</div>
                </div>

                <div class="form-actions mt-4">
                    <a href="/Pagos" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary btn-icon">
                        <i class="bi bi-check-lg"></i> Registrar Pago
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
}
