@model Pago
@{
    ViewData["Title"] = $"Pago — {Model.Referencia}";
    bool esPendiente = Model.Estado == EstadoPago.Pendiente;
}
<div class="page-header">
    <div>
        <h1 class="page-title">Detalle de Pago</h1>
        <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/Pagos">Pagos</a></li><li class="breadcrumb-item active">@Model.Referencia</li></ol></nav>
    </div>
    <div class="d-flex gap-2">
        @if (esPendiente)
        {
            <form asp-action="Confirmar" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success btn-icon"
                        onclick="return confirm('¿Confirmar el pago y enviar correo al feligrés?')">
                    <i class="bi bi-check-circle-fill"></i> Confirmar Pago
                </button>
            </form>
            <form asp-action="Rechazar" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-icon"
                        onclick="return confirm('¿Rechazar este pago?')">
                    <i class="bi bi-x-circle"></i> Rechazar
                </button>
            </form>
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-6">
        <div class="card-panel">
            <div class="panel-header"><h5 class="panel-title"><i class="bi bi-receipt text-success me-2"></i>Información del Pago</h5></div>
            <div class="detail-grid">
                <div class="detail-item"><span class="detail-label">Referencia</span><code class="detail-value">@Model.Referencia</code></div>
                <div class="detail-item"><span class="detail-label">Solicitante</span><span class="detail-value">@Model.NombreSolicitante</span></div>
                <div class="detail-item"><span class="detail-label">Correo</span><span class="detail-value">@(Model.EmailNotificacion ?? "—")</span></div>
                <div class="detail-item"><span class="detail-label">Tipo de Servicio</span><span class="detail-value"><span class="badge badge-light">@Model.TipoServicio</span></span></div>
                <div class="detail-item"><span class="detail-label">Monto</span><span class="detail-value fw-600 text-success" style="font-size:1.2rem">$@Model.Monto.ToString("N2") MXN</span></div>
                <div class="detail-item"><span class="detail-label">Método</span><span class="detail-value">@Model.MetodoPago</span></div>
                <div class="detail-item"><span class="detail-label">Fecha de Pago</span><span class="detail-value">@(Model.FechaPago.HasValue ? Model.FechaPago.Value.ToString("dd/MM/yyyy") : "—")</span></div>
                <div class="detail-item">
                    <span class="detail-label">Estado</span>
                    <span class="detail-value">
                        <span class="badge @(Model.Estado == EstadoPago.Confirmado ? "badge-success" : Model.Estado == EstadoPago.Pendiente ? "badge-warning" : "badge-danger")">
                            @Model.Estado
                        </span>
                    </span>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(Model.Notas))
            { <hr><p class="text-muted small mb-0"><strong>Notas:</strong> @Model.Notas</p> }
        </div>
    </div>
    <div class="col-12 col-lg-6">
        @if (Model.Estado == EstadoPago.Confirmado && !string.IsNullOrEmpty(Model.EmailNotificacion))
        {
            <div class="card-panel">
                <div class="d-flex align-items-center gap-3 py-2">
                    <div class="stat-icon" style="background:linear-gradient(135deg,#22c55e,#16a34a);color:#fff;border-radius:12px;width:48px;height:48px;display:flex;align-items:center;justify-content:center;font-size:1.4rem;flex-shrink:0">
                        <i class="bi bi-envelope-check-fill"></i>
                    </div>
                    <div>
                        <div class="fw-600">Correo de confirmación enviado</div>
                        <div class="text-muted small">Se notificó a @Model.EmailNotificacion</div>
                    </div>
                </div>
            </div>
        }
        <div class="card-panel mt-4">
            <div class="panel-header"><h5 class="panel-title">Registro</h5></div>
            <div class="detail-grid">
                <div class="detail-item"><span class="detail-label">Fecha de registro</span><span class="detail-value">@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</span></div>
            </div>
        </div>
    </div>
</div>
