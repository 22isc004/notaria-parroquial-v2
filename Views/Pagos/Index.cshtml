@model IEnumerable<Pago>
@{
    ViewData["Title"] = "Pagos";
    string q = ViewBag.Query ?? "";
    int page = ViewBag.Page; int totalPages = ViewBag.TotalPages;
    EstadoPago? estado = ViewBag.Estado;
}
<div class="page-header">
    <div>
        <h1 class="page-title"><i class="bi bi-cash-coin text-success me-2"></i>Pagos</h1>
        <p class="page-desc">@ViewBag.Total registro(s)</p>
    </div>
    <a href="/Pagos/Create" class="btn btn-primary btn-icon"><i class="bi bi-plus-lg"></i> Registrar Pago</a>
</div>
<div class="card-panel mb-4">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-12 col-md-5"><div class="input-group"><span class="input-group-text"><i class="bi bi-search"></i></span><input type="text" name="q" value="@q" class="form-control" placeholder="Buscar por nombre o referencia…" /></div></div>
        <div class="col-12 col-md-3"><select name="estado" class="form-select"><option value="">Todos los estados</option>@foreach (EstadoPago e in Enum.GetValues<EstadoPago>()) { <option value="@((int)e)" selected="@(estado == e)">@e</option> }</select></div>
        <div class="col-auto"><button type="submit" class="btn btn-primary">Filtrar</button>@if (!string.IsNullOrEmpty(q) || estado.HasValue) { <a href="/Pagos" class="btn btn-outline-secondary ms-1">Limpiar</a> }</div>
    </form>
</div>
@if (Model.Any())
{
    <div class="card-panel p-0">
        <div class="table-responsive">
            <table class="table table-hover data-table mb-0">
                <thead><tr><th>Referencia</th><th>Solicitante</th><th>Servicio</th><th>Monto</th><th>Fecha Pago</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td><code class="badge-code">@p.Referencia</code></td>
                            <td><div class="fw-500">@p.NombreSolicitante</div><small class="text-muted">@p.EmailNotificacion</small></td>
                            <td><span class="badge badge-light">@p.TipoServicio</span></td>
                            <td class="fw-600 text-success">$@p.Monto.ToString("N2")</td>
                            <td>@(p.FechaPago.HasValue ? p.FechaPago.Value.ToString("dd/MM/yyyy") : "—")</td>
                            <td>
                                <span class="badge @(p.Estado == EstadoPago.Confirmado ? "badge-success" : p.Estado == EstadoPago.Pendiente ? "badge-warning" : "badge-danger")">
                                    @p.Estado
                                </span>
                            </td>
                            <td class="text-end">
                                <a href="/Pagos/Details/@p.Id" class="btn btn-sm btn-outline-secondary" aria-label="Ver detalle"><i class="bi bi-eye"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (totalPages > 1)
    {
        <nav class="mt-4 d-flex justify-content-center"><ul class="pagination">
            <li class="page-item @(page <= 1 ? "disabled" : "")"><a class="page-link" href="?q=@q&page=@(page-1)"><i class="bi bi-chevron-left"></i></a></li>
            @for (int i = Math.Max(1, page-2); i <= Math.Min(totalPages, page+2); i++) { <li class="page-item @(i==page?"active":"")"><a class="page-link" href="?q=@q&page=@i">@i</a></li> }
            <li class="page-item @(page >= totalPages ? "disabled" : "")"><a class="page-link" href="?q=@q&page=@(page+1)"><i class="bi bi-chevron-right"></i></a></li>
        </ul></nav>
    }
}
else
{
    <div class="empty-state">
        <div class="empty-icon text-success"><i class="bi bi-cash-stack"></i></div>
        <h3>Sin pagos registrados</h3>
        <p class="text-muted">Registra el primer pago de la parroquia.</p>
        <a href="/Pagos/Create" class="btn btn-primary btn-icon"><i class="bi bi-plus-lg"></i> Registrar Pago</a>
    </div>
}
