@model PrimeraComunion
@{
    ViewData["Title"] = "Nueva Primera Comunión";
    var hoy = DateTime.Today.ToString("yyyy-MM-dd");
}
<div class="page-header">
    <div>
        <h1 class="page-title">Registrar Primera Comunión</h1>
        <nav aria-label="breadcrumb"><ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Comuniones">Primera Comunión</a></li>
            <li class="breadcrumb-item active">Nueva</li>
        </ol></nav>
    </div>
</div>
<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card-panel">
            <form asp-action="Create" method="post">
                <div class="form-section-title"><i class="bi bi-cup-hot-fill me-2 text-success"></i>Datos de la Comunión</div>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="FeligresId" class="form-label">Feligrés</label>
                        <select asp-for="FeligresId" class="form-select" asp-items="ViewBag.FeligresList">
                            <option value="">— Seleccionar feligrés —</option>
                        </select>
                        <span asp-validation-for="FeligresId" class="text-danger small"></span>
                        <div class="mt-1">
                            <a href="/Feligreses/Create" target="_blank" class="small text-primary">
                                <i class="bi bi-plus-circle me-1"></i>Registrar nuevo feligrés
                            </a>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="FechaComunion" class="form-label"></label>
                        <input asp-for="FechaComunion" class="form-control" type="date" min="@hoy" />
                        <span asp-validation-for="FechaComunion" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Estado" class="form-label"></label>
                        <select asp-for="Estado" class="form-select" asp-items="Html.GetEnumSelectList<EstadoSolicitud>()"></select>
                        <span asp-validation-for="Estado" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Sacerdote" class="form-label"></label>
                        <input asp-for="Sacerdote" class="form-control" placeholder="Nombre del sacerdote celebrante" />
                        <span asp-validation-for="Sacerdote" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="PadrinoNombre" class="form-label"></label>
                        <input asp-for="PadrinoNombre" class="form-control" placeholder="Nombre del padrino" />
                        <span asp-validation-for="PadrinoNombre" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="MadrinaNombre" class="form-label"></label>
                        <input asp-for="MadrinaNombre" class="form-control" placeholder="Nombre de la madrina" />
                        <span asp-validation-for="MadrinaNombre" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Lugar" class="form-label"></label>
                        <input asp-for="Lugar" class="form-control" placeholder="Iglesia o lugar" />
                        <span asp-validation-for="Lugar" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Observaciones" class="form-label"></label>
                        <textarea asp-for="Observaciones" class="form-control" rows="3" placeholder="Notas adicionales…"></textarea>
                        <span asp-validation-for="Observaciones" class="text-danger small"></span>
                    </div>
                </div>
                <div class="form-actions mt-4">
                    <a href="/Comuniones" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary btn-icon"><i class="bi bi-check-lg"></i> Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
}
