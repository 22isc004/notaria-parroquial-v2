@model PrimeraComunion
@{
    ViewData["Title"] = $"Comunión — {Model.NumeroBoleta}";
}
<div class="page-header">
    <div>
        <h1 class="page-title">Detalle de Primera Comunión</h1>
        <nav aria-label="breadcrumb"><ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Comuniones">Primera Comunión</a></li>
            <li class="breadcrumb-item active">@Model.NumeroBoleta</li>
        </ol></nav>
    </div>
    <a href="/Comuniones/Edit/@Model.Id" class="btn btn-primary btn-icon"><i class="bi bi-pencil"></i> Editar</a>
</div>
<div class="row g-4">
    <div class="col-12 col-lg-8">
        <div class="card-panel">
            <div class="panel-header"><h5 class="panel-title"><i class="bi bi-cup-hot-fill text-success me-2"></i>Información</h5></div>
            <div class="detail-grid">
                <div class="detail-item"><span class="detail-label">No. Boleta</span><code class="detail-value">@Model.NumeroBoleta</code></div>
                <div class="detail-item"><span class="detail-label">Feligrés</span><span class="detail-value">@Model.Feligres?.NombreCompleto</span></div>
                <div class="detail-item"><span class="detail-label">Fecha</span><span class="detail-value">@Model.FechaComunion.ToString("dd MMMM yyyy")</span></div>
                <div class="detail-item"><span class="detail-label">Sacerdote</span><span class="detail-value">@Model.Sacerdote</span></div>
                <div class="detail-item"><span class="detail-label">Padrino</span><span class="detail-value">@(Model.PadrinoNombre ?? "—")</span></div>
                <div class="detail-item"><span class="detail-label">Madrina</span><span class="detail-value">@(Model.MadrinaNombre ?? "—")</span></div>
                <div class="detail-item"><span class="detail-label">Lugar</span><span class="detail-value">@(Model.Lugar ?? "—")</span></div>
                <div class="detail-item">
                    <span class="detail-label">Estado</span>
                    <span class="detail-value"><span class="badge @(Model.Estado == EstadoSolicitud.Completado ? "badge-success" : Model.Estado == EstadoSolicitud.Pendiente ? "badge-warning" : "badge-info")">@Model.Estado</span></span>
                </div>
            </div>
        </div>
    </div>
</div>
