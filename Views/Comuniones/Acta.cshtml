@model PrimeraComunion
@{
    Layout = "~/Views/Shared/_ActaLayout.cshtml";
    ViewData["Title"] = $"Acta de Primera Comunión — {Model.NumeroBoleta}";
    var feligres = Model.Feligres;
    var fechaComunion = Model.FechaComunion.ToString("dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-MX"));
    var fechaNac = feligres?.FechaNacimiento.ToString("dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-MX")) ?? "—";
}

<article class="acta-paper">
    <header class="acta-header">
        <div class="acta-church-name">Notaría Parroquial</div>
        <div class="acta-parish">Parroquia de Axtla de Terrazas, S.L.P.</div>
        <div class="acta-cross">&#10013;</div>
        <div class="acta-title">Acta de Primera Comunión</div>
        <span class="acta-folio">@Model.NumeroBoleta</span>
    </header>

    <div class="acta-body">
        El suscrito Párroco certifica que en los registros de esta Parroquia consta que el día
        <strong>@fechaComunion</strong>, recibió por primera vez el Sacramento de la Eucaristía:
        <br><br>
        <strong>@(feligres?.NombreCompleto ?? "—")</strong>,
        @if (feligres != null)
        {
            <text>nacido/a el <strong>@fechaNac</strong>, originario/a de <strong>@feligres.Comunidad, @feligres.Municipio</strong>,</text>
        }
        habiendo sido celebrado dicho sacramento por el <strong>@Model.Sacerdote</strong>
        en <strong>@(Model.Lugar ?? "—")</strong>.
        Actuaron como padrinos: <strong>@(Model.PadrinoNombre ?? "—")</strong> (padrino)
        y <strong>@(Model.MadrinaNombre ?? "—")</strong> (madrina).
    </div>

    <table class="acta-fields">
        <tr><td>Nombre</td><td><strong>@(feligres?.NombreCompleto ?? "—")</strong></td></tr>
        <tr><td>Fecha de Nacimiento</td><td>@fechaNac</td></tr>
        <tr><td>Fecha de Comunión</td><td>@fechaComunion</td></tr>
        <tr><td>Sacerdote Celebrante</td><td>@Model.Sacerdote</td></tr>
        <tr><td>Padrino</td><td>@(Model.PadrinoNombre ?? "—")</td></tr>
        <tr><td>Madrina</td><td>@(Model.MadrinaNombre ?? "—")</td></tr>
        <tr><td>Lugar</td><td>@(Model.Lugar ?? "—")</td></tr>
        @if (!string.IsNullOrWhiteSpace(Model.Observaciones))
        {
            <tr><td>Observaciones</td><td>@Model.Observaciones</td></tr>
        }
    </table>

    <div class="acta-signatures">
        <div class="sign-block">
            <div class="sign-line"></div>
            <div class="sign-label">Párroco Celebrante</div>
        </div>
        <div class="sign-block">
            <div class="sign-line"></div>
            <div class="sign-label">Secretario Parroquial</div>
        </div>
    </div>

    <div class="acta-footer">
        Documento expedido el @DateTime.Today.ToString("dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-MX")) &nbsp;·&nbsp;
        Notaría Parroquial de Axtla de Terrazas
    </div>
</article>
