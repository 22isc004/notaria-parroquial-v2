@model PrimeraComunion
@{
    Layout = "~/Views/Shared/_ActaLayout.cshtml";
    ViewData["Title"] = $"Acta de Primera Comunión — {Model.NumeroBoleta}";
    var cx   = System.Globalization.CultureInfo.GetCultureInfo("es-MX");
    var f    = Model.Feligres;
    var fCom = Model.FechaComunion.ToString("dd 'de' MMMM 'de' yyyy", cx);
    var fNac = f?.FechaNacimiento.ToString("dd 'de' MMMM 'de' yyyy", cx) ?? "—";
    var fExp = DateOnly.FromDateTime(DateTime.Today).ToString("dd 'de' MMMM 'de' yyyy", cx);
}

<div class="acta-id-strip">
    <div class="diocese-block">
        <strong>Diócesis de Ciudad Valles</strong>
        Provincia Eclesiástica de San Luis Potosí<br>
        República Mexicana
    </div>
    <div class="folio-block">
        Folio de registro<br>
        <span class="folio-num">@Model.NumeroBoleta</span>
    </div>
</div>

<div class="ornament">✦ &nbsp; ✦ &nbsp; ✦</div>

<header class="acta-header">
    <div class="acta-church">Parroquia de Axtla de Terrazas</div>
    <div class="acta-parish-sub">Axtla de Terrazas, San Luis Potosí, México</div>
    <span class="acta-cross-big">✝</span>
    <div class="acta-titulo">Acta de Primera Comunión</div>
</header>

<div class="header-rule"></div>

<span class="cert-label">Certificación</span>

<p class="acta-texto">
    Yo, el Infrascrito Párroco de la Parroquia de <strong>Axtla de Terrazas</strong>, perteneciente
    a la Diócesis de Ciudad Valles, S.L.P., México, <strong>CERTIFICO</strong>: que en el Libro de
    Primeras Comuniones de esta Parroquia consta la siguiente acta:
</p>

<p class="acta-texto">
    En <strong>@(Model.Lugar ?? "—")</strong>, siendo el día
    <strong>@fCom</strong>, el Presbítero <strong>@Model.Sacerdote</strong>
    administró por primera vez el Sacramento de la <strong>Santísima Eucaristía</strong> a:
    <strong>@(f?.NombreCompleto ?? "—")</strong>,
    quien nació el <strong>@fNac</strong>@(f != null ? $", originario/a de {f.Comunidad}, {f.Municipio}, San Luis Potosí" : "").
    Acompañaron como Padrinos de Primera Comunión:
    <strong>@(Model.PadrinoNombre ?? "—")</strong> (Padrino) y
    <strong>@(Model.MadrinaNombre ?? "—")</strong> (Madrina).
</p>

@if (!string.IsNullOrWhiteSpace(Model.Observaciones))
{
    <p class="acta-texto"><em>Observaciones: @Model.Observaciones</em></p>
}

<p class="datos-titulo">Extracto de datos</p>
<table class="datos-tabla">
    <tr><td class="lbl">Nombre</td><td><strong>@(f?.NombreCompleto ?? "—")</strong></td></tr>
    <tr><td class="lbl">Fecha de Nacimiento</td><td>@fNac</td></tr>
    <tr><td class="lbl">Comunidad de Origen</td><td>@(f != null ? $"{f.Comunidad}, {f.Municipio}" : "—")</td></tr>
    <tr><td class="lbl">Fecha de la Comunión</td><td>@fCom</td></tr>
    <tr><td class="lbl">Lugar</td><td>@(Model.Lugar ?? "—")</td></tr>
    <tr><td class="lbl">Ministro Celebrante</td><td>@Model.Sacerdote</td></tr>
    <tr><td class="lbl">Padrino</td><td>@(Model.PadrinoNombre ?? "—")</td></tr>
    <tr><td class="lbl">Madrina</td><td>@(Model.MadrinaNombre ?? "—")</td></tr>
</table>

<p class="cierre">
    Y para los efectos legales y espirituales que convengan, a petición del interesado, firmo y
    sello la presente Acta de Primera Comunión en Axtla de Terrazas, S.L.P., a <strong>@fExp</strong>.
</p>

<div class="firmas-wrap">
    <div class="sello-circulo">
        <div class="sello-cruz">✝</div>
        SELLO<br>PARROQUIAL
    </div>
    <div class="firmas-derecha">
        <div class="firma-bloque">
            <div class="firma-linea"></div>
            <div class="firma-nombre">@Model.Sacerdote</div>
            <div class="firma-cargo">Párroco Celebrante</div>
        </div>
        <div class="firma-bloque">
            <div class="firma-linea"></div>
            <div class="firma-nombre">&nbsp;</div>
            <div class="firma-cargo">Secretario Parroquial</div>
        </div>
    </div>
</div>

<div class="acta-pie">
    Documento expedido el @fExp &nbsp;·&nbsp; Parroquia de Axtla de Terrazas, Diócesis de Ciudad Valles &nbsp;·&nbsp; Folio @Model.NumeroBoleta
</div>
