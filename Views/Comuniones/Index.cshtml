@model IEnumerable<PrimeraComunion>
@{
    ViewData["Title"] = "Primera Comunión";
    string q = ViewBag.Query ?? "";
    int page = ViewBag.Page; int totalPages = ViewBag.TotalPages;
    EstadoSolicitud? estado = ViewBag.Estado;
}
<div class="page-header">
    <div>
        <h1 class="page-title"><i class="bi bi-cup-hot-fill text-success me-2"></i>Primera Comunión</h1>
        <p class="page-desc">@ViewBag.Total registro(s)</p>
    </div>
    <a href="/Comuniones/Create" class="btn btn-primary btn-icon"><i class="bi bi-plus-lg"></i> Nueva Comunión</a>
</div>
<div class="card-panel mb-4">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-12 col-md-6">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" name="q" value="@q" class="form-control" placeholder="Buscar por nombre o boleta…" />
            </div>
        </div>
        <div class="col-12 col-md-3">
            <select name="estado" class="form-select">
                <option value="">Todos los estados</option>
                @foreach (EstadoSolicitud e in Enum.GetValues<EstadoSolicitud>())
                { <option value="@((int)e)" selected="@(estado == e)">@e</option> }
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Filtrar</button>
            @if (!string.IsNullOrEmpty(q) || estado.HasValue) { <a href="/Comuniones" class="btn btn-outline-secondary ms-1">Limpiar</a> }
        </div>
    </form>
</div>
@if (Model.Any())
{
    <div class="card-panel p-0">
        <div class="table-responsive">
            <table class="table table-hover data-table mb-0">
                <thead><tr><th>Boleta</th><th>Feligrés</th><th>Fecha</th><th>Sacerdote</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td><code class="badge-code">@c.NumeroBoleta</code></td>
                            <td><div class="fw-500">@c.Feligres?.NombreCompleto</div><small class="text-muted">@c.Feligres?.Comunidad</small></td>
                            <td>@c.FechaComunion.ToString("dd/MM/yyyy")</td>
                            <td>@c.Sacerdote</td>
                            <td><span class="badge @(c.Estado == EstadoSolicitud.Completado ? "badge-success" : c.Estado == EstadoSolicitud.Pendiente ? "badge-warning" : c.Estado == EstadoSolicitud.Programado ? "badge-info" : "badge-danger")">@c.Estado</span></td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a href="/Comuniones/Details/@c.Id" class="btn btn-outline-secondary" aria-label="Ver"><i class="bi bi-eye"></i></a>
                                    <a href="/Comuniones/Edit/@c.Id" class="btn btn-outline-primary" aria-label="Editar"><i class="bi bi-pencil"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="empty-state">
        <div class="empty-icon text-success"><i class="bi bi-cup-hot"></i></div>
        <h3>Sin comuniones registradas</h3>
        <p class="text-muted">Registra la primera comunión de la parroquia.</p>
        <a href="/Comuniones/Create" class="btn btn-primary btn-icon"><i class="bi bi-plus-lg"></i> Nueva Comunión</a>
    </div>
}
