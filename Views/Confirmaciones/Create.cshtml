@model Confirmacion
@{
    ViewData["Title"] = "Nueva Confirmación";
}
<div class="page-header">
    <div>
        <h1 class="page-title">Registrar Confirmación</h1>
        <nav aria-label="breadcrumb"><ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Confirmaciones">Confirmaciones</a></li>
            <li class="breadcrumb-item active">Nueva</li>
        </ol></nav>
    </div>
</div>
<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card-panel">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="form-section-title"><i class="bi bi-shield-fill-check me-2 text-warning"></i>Datos de la Confirmación</div>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="FeligresId" class="form-label">Feligrés</label>
                        <select asp-for="FeligresId" class="form-select" asp-items="ViewBag.FeligresList"><option value="">— Seleccionar feligrés —</option></select>
                        <span asp-validation-for="FeligresId" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6"><label asp-for="FechaConfirmacion" class="form-label"></label><input asp-for="FechaConfirmacion" class="form-control" type="date" /><span asp-validation-for="FechaConfirmacion" class="text-danger small"></span></div>
                    <div class="col-12 col-md-6"><label asp-for="Estado" class="form-label"></label><select asp-for="Estado" class="form-select" asp-items="Html.GetEnumSelectList<EstadoSolicitud>()"></select></div>
                    <div class="col-12"><label asp-for="Sacerdote" class="form-label"></label><input asp-for="Sacerdote" class="form-control" placeholder="Sacerdote u Obispo" /><span asp-validation-for="Sacerdote" class="text-danger small"></span></div>
                    <div class="col-12 col-md-6"><label asp-for="NombreConfirmacion" class="form-label"></label><input asp-for="NombreConfirmacion" class="form-control" placeholder="Nombre elegido" /></div>
                    <div class="col-12 col-md-6"><label asp-for="PadrinoNombre" class="form-label"></label><input asp-for="PadrinoNombre" class="form-control" /></div>
                    <div class="col-12"><label asp-for="Lugar" class="form-label"></label><input asp-for="Lugar" class="form-control" /></div>
                    <div class="col-12"><label asp-for="Observaciones" class="form-label"></label><textarea asp-for="Observaciones" class="form-control" rows="3"></textarea></div>
                </div>
                <div class="form-actions mt-4">
                    <a href="/Confirmaciones" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary btn-icon"><i class="bi bi-check-lg"></i> Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>
