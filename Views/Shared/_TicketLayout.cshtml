<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Inter', sans-serif;
            background: #d1d5db;
            min-height: 100vh;
            display: flex; flex-direction: column; align-items: center;
            padding: 28px 16px 64px;
        }

        /* ── Toolbar ── */
        .toolbar {
            width: 100%; max-width: 480px;
            display: flex; justify-content: space-between; align-items: center;
            margin-bottom: 18px;
        }
        .btn-back { font-size: .82rem; color: #4b5563; text-decoration: none; display: flex; align-items: center; gap: 5px; }
        .btn-back:hover { color: #111; }
        .btn-print {
            font-size: .85rem; font-weight: 600;
            background: #166534; color: #fff; border: none; border-radius: 6px;
            padding: 10px 22px; cursor: pointer; transition: background .15s;
        }
        .btn-print:hover { background: #14532d; }

        /* ── Ticket ── */
        .ticket {
            width: 100%; max-width: 480px;
            background: #fff;
            border-radius: 4px;
            box-shadow: 0 4px 20px rgba(0,0,0,.15);
            overflow: hidden;
        }

        /* Header strip */
        .ticket-header {
            background: #1e3d0e;
            padding: 24px 28px 20px;
            text-align: center;
            color: #fff;
        }
        .ticket-logo { font-size: .7rem; letter-spacing: .18em; text-transform: uppercase; color: #a3b899; margin-bottom: 6px; }
        .ticket-org { font-size: 1.1rem; font-weight: 700; letter-spacing: .04em; }
        .ticket-org-sub { font-size: .78rem; color: #a3b899; margin-top: 2px; }

        /* Type badge */
        .ticket-type {
            background: #f0fdf4;
            border-bottom: 1px solid #d1fae5;
            padding: 10px 28px;
            text-align: center;
            font-size: .72rem; font-weight: 700;
            letter-spacing: .16em; text-transform: uppercase; color: #166534;
        }

        /* Body */
        .ticket-body { padding: 22px 28px; }

        /* Reference */
        .ticket-ref {
            text-align: center; margin-bottom: 20px;
            padding-bottom: 20px;
            border-bottom: 1px dashed #e5e7eb;
        }
        .ref-label { font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: #9ca3af; }
        .ref-num {
            font-family: 'JetBrains Mono', monospace;
            font-size: 1.25rem; font-weight: 600; color: #111827;
            margin-top: 4px; letter-spacing: .06em;
        }

        /* Fields */
        .campo { display: flex; justify-content: space-between; align-items: baseline; padding: 7px 0; border-bottom: 1px solid #f3f4f6; gap: 12px; }
        .campo:last-child { border-bottom: none; }
        .campo-lbl { font-size: .75rem; font-weight: 500; color: #6b7280; white-space: nowrap; }
        .campo-val { font-size: .88rem; font-weight: 500; color: #111827; text-align: right; }

        /* Amount */
        .ticket-amount {
            text-align: center; margin: 22px 0;
            padding: 18px;
            background: #f9fafb; border-radius: 8px;
        }
        .amount-label { font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: #9ca3af; }
        .amount-value {
            font-size: 2rem; font-weight: 800;
            color: #166534; margin-top: 4px; letter-spacing: -.02em;
        }
        .amount-method { font-size: .78rem; color: #6b7280; margin-top: 4px; }

        /* Status */
        .ticket-status {
            text-align: center; margin: 18px 0 0;
        }
        .status-badge {
            display: inline-block; padding: 6px 20px; border-radius: 999px;
            font-size: .8rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
        }
        .status-confirmado { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
        .status-pendiente  { background: #fef9c3; color: #854d0e; border: 1px solid #fde68a; }
        .status-rechazado  { background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }

        /* Tear separator */
        .tear {
            position: relative; margin: 8px 0;
            height: 1px;
            background: repeating-linear-gradient(to right, #d1d5db 0, #d1d5db 6px, transparent 6px, transparent 12px);
        }
        .tear::before, .tear::after {
            content: '';
            position: absolute; top: 50%; transform: translateY(-50%);
            width: 20px; height: 20px;
            background: #d1d5db; border-radius: 50%;
        }
        .tear::before { left: -10px; }
        .tear::after  { right: -10px; }

        /* Footer */
        .ticket-footer {
            background: #f9fafb; padding: 16px 28px;
            text-align: center;
        }
        .ticket-footer p { font-size: .7rem; color: #9ca3af; line-height: 1.6; }

        /* Barcode decoration */
        .barcode {
            display: flex; justify-content: center; gap: 2px;
            margin-top: 12px; opacity: .3;
        }
        .barcode span {
            display: inline-block; height: 28px;
            background: #374151;
        }

        /* ── Print ── */
        @@media print {
            body { background: white; padding: 0; }
            .toolbar { display: none; }
            .ticket { box-shadow: none; max-width: 100%; border-radius: 0; }
            .tear::before, .tear::after { background: white; }
            @@page { size: A5 portrait; margin: 0; }
        }
    </style>
</head>
<body>

<div class="toolbar">
    <a href="javascript:history.back()" class="btn-back">&#8592; Volver</a>
    <button class="btn-print" onclick="window.print()">&#128438;&nbsp; Imprimir Ticket</button>
</div>

<div class="ticket">
    @RenderBody()
</div>

</body>
</html>
