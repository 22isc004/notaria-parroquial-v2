<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'EB Garamond', Georgia, serif;
            background: #e8e0d4;
            color: #1a1203;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 28px 16px 72px;
        }

        /* ── Toolbar ── */
        .toolbar {
            width: 100%; max-width: 800px;
            display: flex; justify-content: space-between; align-items: center;
            margin-bottom: 18px;
        }
        .btn-back {
            font-family: 'Inter', sans-serif; font-size: .82rem; color: #6b5e47;
            text-decoration: none; display: flex; align-items: center; gap: 5px;
        }
        .btn-back:hover { color: #1a1203; }
        .btn-print {
            font-family: 'Inter', sans-serif; font-size: .85rem; font-weight: 600;
            background: #1e3d0e; color: #fff; border: none; border-radius: 6px;
            padding: 10px 22px; cursor: pointer; letter-spacing: .02em;
            transition: background .15s;
        }
        .btn-print:hover { background: #142b09; }

        /* ── Paper ── */
        .papel {
            width: 100%; max-width: 800px;
            background: #fdfaf4;
            box-shadow: 0 6px 32px rgba(0,0,0,.18);
            padding: 0;
            position: relative;
        }

        /* Outer gold border */
        .papel::before {
            content: '';
            position: absolute; inset: 10px;
            border: 2px solid #c8a84b;
            pointer-events: none; z-index: 1;
        }
        /* Inner thin border */
        .papel::after {
            content: '';
            position: absolute; inset: 15px;
            border: .5px solid #c8a84b;
            pointer-events: none; z-index: 1;
        }

        /* ── Inner content wrapper ── */
        .papel-inner { padding: 52px 60px 60px; }

        /* ── Top identifier strip ── */
        .acta-id-strip {
            display: flex; justify-content: space-between; align-items: flex-start;
            margin-bottom: 28px;
        }
        .diocese-block { font-size: .78rem; color: #7a6a4f; line-height: 1.5; }
        .diocese-block strong { font-family: 'Cinzel', serif; font-size: .8rem; color: #1e3d0e; display: block; }
        .folio-block {
            text-align: right; font-family: 'Inter', sans-serif; font-size: .73rem;
            color: #7a6a4f; line-height: 1.6;
        }
        .folio-num {
            display: inline-block; margin-top: 2px;
            background: #1e3d0e; color: #fff; font-weight: 700;
            font-size: .75rem; letter-spacing: .08em;
            padding: 4px 12px; border-radius: 3px;
        }

        /* ── Divider ornamental ── */
        .ornament {
            text-align: center; margin: 0 0 22px;
            font-size: .9rem; color: #c8a84b; letter-spacing: .4em;
        }

        /* ── Header ── */
        .acta-header { text-align: center; margin-bottom: 32px; }
        .acta-church {
            font-family: 'Cinzel', serif;
            font-size: 1.18rem; font-weight: 700;
            letter-spacing: .1em; color: #1e3d0e;
            text-transform: uppercase;
        }
        .acta-parish-sub {
            font-size: .88rem; font-style: italic; color: #6b5a3a; margin-top: 3px;
        }
        .acta-cross-big {
            font-size: 2.4rem; color: #c8a84b; display: block;
            margin: 16px 0 12px; line-height: 1;
        }
        .acta-titulo {
            font-family: 'Cinzel', serif;
            font-size: 1.55rem; font-weight: 700;
            letter-spacing: .12em; color: #1a1203;
            text-transform: uppercase;
        }

        /* ── Header separator ── */
        .header-rule {
            width: 100%; height: 2px;
            background: linear-gradient(to right, transparent, #c8a84b 20%, #c8a84b 80%, transparent);
            margin: 24px 0 28px;
        }

        /* ── Certification text ── */
        .cert-label {
            font-family: 'Cinzel', serif; font-size: .78rem; font-weight: 600;
            letter-spacing: .18em; color: #1e3d0e; text-transform: uppercase;
            display: block; margin-bottom: 14px;
        }
        .acta-texto {
            font-size: 1.07rem; line-height: 1.9; color: #1a1203;
            text-align: justify; margin-bottom: 10px;
        }
        .acta-texto strong { font-weight: 600; }

        /* ── Datos ── */
        .datos-titulo {
            font-family: 'Cinzel', serif; font-size: .72rem; font-weight: 600;
            letter-spacing: .18em; color: #7a6a4f; text-transform: uppercase;
            margin: 28px 0 10px;
        }
        .datos-tabla {
            width: 100%; border-collapse: collapse;
            font-size: .97rem; margin-bottom: 16px;
        }
        .datos-tabla tr { border-bottom: 1px solid #e2d9c8; }
        .datos-tabla tr:last-child { border-bottom: none; }
        .datos-tabla td { padding: 7px 6px; vertical-align: top; }
        .datos-tabla td.lbl {
            width: 36%; font-family: 'Inter', sans-serif; font-size: .77rem;
            font-weight: 600; color: #8a7558; letter-spacing: .05em;
            text-transform: uppercase; padding-right: 16px; white-space: nowrap;
        }

        /* ── Cierre ── */
        .cierre {
            font-size: .98rem; line-height: 1.85; color: #1a1203;
            text-align: justify; margin-top: 24px; font-style: italic;
        }

        /* ── Firmas ── */
        .firmas-wrap {
            display: flex; align-items: flex-end; justify-content: space-between;
            gap: 24px; margin-top: 56px;
        }
        .sello-circulo {
            width: 110px; height: 110px; flex-shrink: 0;
            border-radius: 50%; border: 2px dashed #c8a84b;
            display: flex; flex-direction: column;
            align-items: center; justify-content: center; text-align: center;
            color: #c8a84b; font-family: 'Inter', sans-serif;
            font-size: .6rem; font-weight: 600; letter-spacing: .1em;
            text-transform: uppercase; line-height: 1.5;
        }
        .sello-cruz { font-size: 1.4rem; margin-bottom: 2px; }
        .firmas-derecha { flex: 1; display: flex; justify-content: space-around; gap: 24px; }
        .firma-bloque { flex: 1; text-align: center; }
        .firma-linea { border-top: 1.5px solid #1a1203; margin-bottom: 6px; }
        .firma-nombre { font-size: .88rem; color: #1a1203; font-weight: 500; }
        .firma-cargo {
            font-family: 'Inter', sans-serif; font-size: .68rem; color: #7a6a4f;
            text-transform: uppercase; letter-spacing: .08em; margin-top: 2px;
        }

        /* ── Footer ── */
        .acta-pie {
            margin-top: 36px; padding-top: 16px;
            border-top: 1px solid #e2d9c8;
            text-align: center; font-family: 'Inter', sans-serif;
            font-size: .7rem; color: #9e8e74; letter-spacing: .03em;
        }

        /* ── Print ── */
        @@media print {
            body { background: white; padding: 0; }
            .toolbar { display: none; }
            .papel {
                box-shadow: none; max-width: 100%;
            }
            .papel-inner { padding: 18mm 22mm 22mm; }
            .papel::before { inset: 8mm; }
            .papel::after { inset: 12mm; }
            @@page { size: A4 portrait; margin: 0; }
        }
    </style>
</head>
<body>

<div class="toolbar">
    <a href="javascript:history.back()" class="btn-back">&#8592; Volver</a>
    <button class="btn-print" onclick="window.print()">&#128438;&nbsp; Imprimir</button>
</div>

<div class="papel">
    <div class="papel-inner">
        @RenderBody()
    </div>
</div>

</body>
</html>
