@model Matrimonio
@{
    ViewData["Title"] = "Editar Matrimonio";
}
<div class="page-header">
    <div>
        <h1 class="page-title">Editar Matrimonio</h1>
        <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/Matrimonios">Matrimonios</a></li><li class="breadcrumb-item active">Editar</li></ol></nav>
    </div>
</div>
<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card-panel">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" /><input asp-for="FechaRegistro" type="hidden" /><input asp-for="NumeroActa" type="hidden" /><input asp-for="PagoId" type="hidden" /><input asp-for="IsDeleted" type="hidden" />
                <div class="form-section-title"><i class="bi bi-heart-fill me-2" style="color:#ec4899"></i>Contrayentes</div>
                <div class="row g-3">
                    <div class="col-12 col-md-6"><label asp-for="Contrayente1Nombre" class="form-label"></label><input asp-for="Contrayente1Nombre" class="form-control" /><span asp-validation-for="Contrayente1Nombre" class="text-danger small"></span></div>
                    <div class="col-12 col-md-6"><label asp-for="Contrayente2Nombre" class="form-label"></label><input asp-for="Contrayente2Nombre" class="form-control" /><span asp-validation-for="Contrayente2Nombre" class="text-danger small"></span></div>
                </div>
                <hr class="my-4">
                <div class="form-section-title"><i class="bi bi-calendar3 me-2"></i>Datos de la Ceremonia</div>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="FechaMatrimonio" class="form-label"></label>
                        <input asp-for="FechaMatrimonio" class="form-control" type="date" />
                        <span asp-validation-for="FechaMatrimonio" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Estado" class="form-label"></label>
                        <select asp-for="Estado" class="form-select" asp-items="Html.GetEnumSelectList<EstadoSolicitud>()"></select>
                        <span asp-validation-for="Estado" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Sacerdote" class="form-label"></label>
                        <input asp-for="Sacerdote" class="form-control" />
                        <span asp-validation-for="Sacerdote" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Testigo1" class="form-label"></label>
                        <input asp-for="Testigo1" class="form-control" />
                        <span asp-validation-for="Testigo1" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Testigo2" class="form-label"></label>
                        <input asp-for="Testigo2" class="form-control" />
                        <span asp-validation-for="Testigo2" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Lugar" class="form-label"></label>
                        <input asp-for="Lugar" class="form-control" />
                        <span asp-validation-for="Lugar" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Observaciones" class="form-label"></label>
                        <textarea asp-for="Observaciones" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Observaciones" class="text-danger small"></span>
                    </div>
                </div>
                <div class="form-actions mt-4">
                    <a href="/Matrimonios" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary btn-icon"><i class="bi bi-check-lg"></i> Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
}
