@model Matrimonio
@{
    Layout = "~/Views/Shared/_ActaLayout.cshtml";
    ViewData["Title"] = $"Acta de Matrimonio — {Model.NumeroActa}";
    var cx   = System.Globalization.CultureInfo.GetCultureInfo("es-MX");
    var fMat = Model.FechaMatrimonio.ToString("dd 'de' MMMM 'de' yyyy", cx);
    var fExp = DateOnly.FromDateTime(DateTime.Today).ToString("dd 'de' MMMM 'de' yyyy", cx);
}

<div class="acta-id-strip">
    <div class="diocese-block">
        <strong>Diócesis de Ciudad Valles</strong>
        Provincia Eclesiástica de San Luis Potosí<br>
        República Mexicana
    </div>
    <div class="folio-block">
        No. de Acta<br>
        <span class="folio-num">@Model.NumeroActa</span>
    </div>
</div>

<div class="ornament">✦ &nbsp; ✦ &nbsp; ✦</div>

<header class="acta-header">
    <div class="acta-church">Parroquia de Axtla de Terrazas</div>
    <div class="acta-parish-sub">Axtla de Terrazas, San Luis Potosí, México</div>
    <span class="acta-cross-big">✝</span>
    <div class="acta-titulo">Acta de Matrimonio</div>
</header>

<div class="header-rule"></div>

<span class="cert-label">Certificación</span>

<p class="acta-texto">
    Yo, el Infrascrito Párroco de la Parroquia de <strong>Axtla de Terrazas</strong>, perteneciente
    a la Diócesis de Ciudad Valles, S.L.P., México, <strong>CERTIFICO</strong>: que en el Libro de
    Matrimonios de esta Parroquia consta la siguiente acta:
</p>

<p class="acta-texto">
    En <strong>@(Model.Lugar ?? "—")</strong>, siendo el día
    <strong>@fMat</strong>, ante el Presbítero <strong>@Model.Sacerdote</strong>,
    contrajeron el Sacramento del <strong>Matrimonio</strong>:
    <strong>@Model.Contrayente1Nombre</strong> y <strong>@Model.Contrayente2Nombre</strong>.
    Actuaron como testigos de esta sagrada unión:
    <strong>@(Model.Testigo1 ?? "—")</strong> y <strong>@(Model.Testigo2 ?? "—")</strong>.
</p>

@if (!string.IsNullOrWhiteSpace(Model.Observaciones))
{
    <p class="acta-texto"><em>Observaciones: @Model.Observaciones</em></p>
}

<p class="datos-titulo">Extracto de datos</p>
<table class="datos-tabla">
    <tr><td class="lbl">Contrayente 1</td><td><strong>@Model.Contrayente1Nombre</strong></td></tr>
    <tr><td class="lbl">Contrayente 2</td><td><strong>@Model.Contrayente2Nombre</strong></td></tr>
    <tr><td class="lbl">Fecha del Matrimonio</td><td>@fMat</td></tr>
    <tr><td class="lbl">Lugar de la Ceremonia</td><td>@(Model.Lugar ?? "—")</td></tr>
    <tr><td class="lbl">Ministro Celebrante</td><td>@Model.Sacerdote</td></tr>
    <tr><td class="lbl">Testigo 1</td><td>@(Model.Testigo1 ?? "—")</td></tr>
    <tr><td class="lbl">Testigo 2</td><td>@(Model.Testigo2 ?? "—")</td></tr>
</table>

<p class="cierre">
    Y para los efectos legales y espirituales que convengan, a petición de los interesados, firmo y
    sello la presente Acta de Matrimonio en Axtla de Terrazas, S.L.P., a <strong>@fExp</strong>.
</p>

<div class="firmas-wrap">
    <div class="sello-circulo">
        <div class="sello-cruz">✝</div>
        SELLO<br>PARROQUIAL
    </div>
    <div class="firmas-derecha">
        <div class="firma-bloque">
            <div class="firma-linea"></div>
            <div class="firma-nombre">@Model.Contrayente1Nombre</div>
            <div class="firma-cargo">Contrayente</div>
        </div>
        <div class="firma-bloque">
            <div class="firma-linea"></div>
            <div class="firma-nombre">@Model.Contrayente2Nombre</div>
            <div class="firma-cargo">Contrayente</div>
        </div>
        <div class="firma-bloque">
            <div class="firma-linea"></div>
            <div class="firma-nombre">@Model.Sacerdote</div>
            <div class="firma-cargo">Párroco Celebrante</div>
        </div>
    </div>
</div>

<div class="acta-pie">
    Documento expedido el @fExp &nbsp;·&nbsp; Parroquia de Axtla de Terrazas, Diócesis de Ciudad Valles &nbsp;·&nbsp; Acta @Model.NumeroActa
</div>
