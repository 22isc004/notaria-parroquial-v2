@model Matrimonio
@{
    ViewData["Title"] = $"Matrimonio — {Model.NumeroActa}";
}
<div class="page-header">
    <div>
        <h1 class="page-title">Detalle de Matrimonio</h1>
        <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/Matrimonios">Matrimonios</a></li><li class="breadcrumb-item active">@Model.NumeroActa</li></ol></nav>
    </div>
    <div class="d-flex gap-2">
        <a href="/Matrimonios/Acta/@Model.Id" target="_blank" class="btn btn-outline-secondary btn-icon">
            <i class="bi bi-printer-fill"></i> Imprimir Acta
        </a>
        <a href="/Matrimonios/Edit/@Model.Id" class="btn btn-primary btn-icon"><i class="bi bi-pencil"></i> Editar</a>
    </div>
</div>
<div class="row g-4">
    <div class="col-12 col-lg-6">
        <div class="card-panel">
            <div class="panel-header"><h5 class="panel-title"><i class="bi bi-heart-fill me-2" style="color:#ec4899"></i>Información del Matrimonio</h5></div>
            <div class="detail-grid">
                <div class="detail-item"><span class="detail-label">No. Acta</span><code class="detail-value">@Model.NumeroActa</code></div>
                <div class="detail-item"><span class="detail-label">Contrayente 1</span><span class="detail-value">@Model.Contrayente1Nombre</span></div>
                <div class="detail-item"><span class="detail-label">Contrayente 2</span><span class="detail-value">@Model.Contrayente2Nombre</span></div>
                <div class="detail-item"><span class="detail-label">Fecha</span><span class="detail-value">@Model.FechaMatrimonio.ToString("dd MMMM yyyy")</span></div>
                <div class="detail-item"><span class="detail-label">Sacerdote</span><span class="detail-value">@Model.Sacerdote</span></div>
                <div class="detail-item"><span class="detail-label">Testigo 1</span><span class="detail-value">@(Model.Testigo1 ?? "—")</span></div>
                <div class="detail-item"><span class="detail-label">Testigo 2</span><span class="detail-value">@(Model.Testigo2 ?? "—")</span></div>
                <div class="detail-item"><span class="detail-label">Lugar</span><span class="detail-value">@(Model.Lugar ?? "—")</span></div>
                <div class="detail-item">
                    <span class="detail-label">Estado</span>
                    <span class="detail-value"><span class="badge @(Model.Estado == EstadoSolicitud.Completado ? "badge-success" : Model.Estado == EstadoSolicitud.Pendiente ? "badge-warning" : "badge-info")">@Model.Estado</span></span>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(Model.Observaciones))
            { <hr><p class="text-muted small mb-0"><strong>Observaciones:</strong> @Model.Observaciones</p> }
        </div>
    </div>
    <div class="col-12 col-lg-6">
        <div class="card-panel">
            <div class="panel-header">
                <h5 class="panel-title"><i class="bi bi-cash-coin text-success me-2"></i>Pago</h5>
                @if (Model.Pago == null)
                {
                    <a href="/Pagos/Create?tipo=Matrimonio&sacramentoId=@Model.Id" class="btn btn-sm btn-outline-success btn-icon">
                        <i class="bi bi-cash-coin"></i> Registrar pago
                    </a>
                }
            </div>
            @if (Model.Pago != null)
            {
                <div class="detail-grid">
                    <div class="detail-item"><span class="detail-label">Referencia</span><code class="detail-value">@Model.Pago.Referencia</code></div>
                    <div class="detail-item"><span class="detail-label">Monto</span><span class="detail-value text-success fw-600">$@Model.Pago.Monto.ToString("N2")</span></div>
                    <div class="detail-item"><span class="detail-label">Estado</span><span class="detail-value"><span class="badge @(Model.Pago.Estado == EstadoPago.Confirmado ? "badge-success" : Model.Pago.Estado == EstadoPago.Pendiente ? "badge-warning" : "badge-danger")">@Model.Pago.Estado</span></span></div>
                </div>
                <a href="/Pagos/Details/@Model.Pago.Id" class="btn btn-sm btn-outline-secondary mt-2">Ver detalle del pago</a>
            }
            else
            {
                <div class="empty-state-sm"><i class="bi bi-receipt"></i><p>Sin pago registrado</p></div>
            }
        </div>
    </div>
</div>
